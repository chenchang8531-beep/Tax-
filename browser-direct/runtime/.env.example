# EXAMPLES ONLY: never put real tokens in GitHub or plugin source.
LIMING_BROWSER_PORT=59422
LIMING_ACTION_LEDGER_PATH=YOUR_USER_PROTECTED_LOCAL_PATH\action-wal.jsonl
LIMING_TASK_LEDGER_PATH=YOUR_USER_PROTECTED_LOCAL_PATH\task-tabs-wal.jsonl
LIMING_EXPECTED_CHROME_USER_DATA_DIR=EXACT_CURRENT_VERIFIED_CHROME_DIR
LIMING_EXPECTED_CHROME_PROFILE_DIRECTORY=EXACT_PROFILE_IF_USED
LIMING_EXPECTED_CHROME_EXE=EXACT_VERIFIED_CHROME_EXE
LIMING_ALLOWED_ORIGINS=
# Real tokens are generated locally (Windows DPAPI) and separately in cloud secrets.
# LIMING_BROWSER_TOKEN (Windows only)
# LIMING_GATEWAY_AGENT_TOKEN (Windows + cloud)
# LIMING_GATEWAY_FRONTEND_TOKEN (cloud + authenticated host connector)
# LIMING_GATEWAY_AGENT_ID (current exact Windows identity)
# LIMING_GATEWAY_URL (HTTPS from actual deployment)
# Production does not accept a manually asserted LIMING_PROFILE_ATTESTED boolean.
